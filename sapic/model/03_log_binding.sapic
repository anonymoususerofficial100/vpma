theory VPMA_03_LogBinding
begin

builtins: hashing, signing

let Provisioning =
    new binGood;
    insert 'bin_good', binGood;

    out(<'endorsed_build', h(binGood)>)

let TPMProvision =
    new aik;
    insert 'aik_priv', aik;
    insert 'aik_pub_pinned', pk(aik);
    insert 'pcr10', 'zero';
    event TPMReady(pk(aik));
    out(<'aik_pub', pk(aik)>)

let TPMExtend =
    !( in(<'extend', digest>);
       lookup 'pcr10' as cur in
         let nxt = h(<cur, digest>) in
         event PCRExtend(cur, digest, nxt);
         insert 'pcr10', nxt
       else 0 )

let TPMQuote =
    !( in(<'quote_req', nonce>);
       lookup 'aik_priv' as aik in
       lookup 'pcr10' as v in
         let quoted = <'quote', v, nonce> in
         event TPMQuoted(v, nonce);
         out(<quoted, sign(quoted, aik)>)
       else 0
       else 0 )

let HostBoot =
    lookup 'bin_good' as b in
      let mb = h(b) in
      event BinaryMeasured(mb);
      out(<'extend', mb>)
    else 0

let IMALogService =
    !( in('ima_log_req');
       lookup 'bin_good' as b in
         out(<'ima_log', h(b)>)
       else 0 )

let Verifier =
    !( lookup 'aik_pub_pinned' as apk in
         new n;
         out(<'quote_req', n>);
         in(<<'quote', v, nr>, sig>);
         if nr = n then
         if verify(sig, <'quote', v, nr>, apk) = true then
           out('ima_log_req');
           in(<'ima_log', logb>);
           if h(<'zero', logb>) = v then
             event LogAccepted(logb, v, nr)
       else 0 )

process:
    Provisioning | TPMProvision | TPMExtend | TPMQuote
  | HostBoot | IMALogService | Verifier

lemma log_binds_to_register:
  "All logb v n #i.
     LogAccepted(logb, v, n) @ #i
     ==> Ex cur #j. PCRExtend(cur, logb, v) @ #j & #j < #i"

lemma exec_log_accepted:
  exists-trace
  "Ex logb v n #i. LogAccepted(logb, v, n) @ #i"

end
