theory VPMA
begin

builtins: hashing, signing

functions:
    hmac/2,
    uhash/2,
    mroot/1,
    kdf/2

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction Inequality:
    "All x y #i. Neq(x, y) @ #i ==> not(x = y)"

restriction AIKObtainedOutOfBand:
    "All plat pubk #i. Registered(plat, pubk) @ #i
        ==> Ex p0 p7 #j. TPMInit(plat, pubk, p0, p7) @ #j & #j < #i"

restriction OnlyOncePerId:
    "All tag id #i #j. OnlyOnce(tag, id) @ #i & OnlyOnce(tag, id) @ #j
        ==> #i = #j"

let Provisioning =
    new binGood;
    new ktag;
    new kchain;
    event Provisioned(binGood);
    event OnlyOnce('setup', 'global');
    event SecretKey('tag',   ktag);
    event SecretKey('chain', kchain);
    insert 'bin_good', binGood;
    insert 'k_tag',    ktag;
    insert 'k_chain',  kchain;
    insert 'batch',   'empty';
    insert 'croot',   'zero';
    insert 'blockno', 'zero';

    out(<'endorsed_build', h(binGood)>)

let ReferenceRegister =

    in(<'aik_pub', 'host', aikpub>);
    event Registered('host', aikpub);
    new n0;
    out(<'quote_req', 'host', n0>);
    in(<<'quote', 'host', v0, v7, v10, nr>, sig>);
    if nr = n0 then
    if verify(sig, <'quote', 'host', v0, v7, v10, nr>, aikpub) = true then
      lookup 'bin_good' as b in
        event OnlyOnce('provision', 'host');
        event ReferenceStateFixed('host', v0, v7, v10, h(b));
        insert 'aik_host',  aikpub;
        insert 'ref_state', <v0, v7, v10, h(b)>
      else 0
    else 0

let TPMProvision(plat) =
    new aik;
    new pcr0_seed;
    new pcr7_seed;
    let pcr0 = h(pcr0_seed) in
    let pcr7 = h(pcr7_seed) in
    event TPMInit(plat, pk(aik), pcr0, pcr7);

    insert <'aik_priv', plat>, aik;
    insert <'pcr0',  plat>, pcr0;
    insert <'pcr7',  plat>, pcr7;
    insert <'pcr10', plat>, 'zero';
    out(<'aik_pub', plat, pk(aik)>)

let TPMExtend(plat) =
    !( in(<'extend', =plat, digest>);
       lookup <'pcr10', plat> as cur in
         let nxt = h(<cur, digest>) in
         insert <'pcr10', plat>, nxt;
         event PCRExtend(plat, cur, digest, nxt)
       else 0 )

let TPMQuote(plat) =
    !( in(<'quote_req', =plat, nonce>);
       lookup <'aik_priv', plat> as aik in
       lookup <'pcr0',  plat> as v0 in
       lookup <'pcr7',  plat> as v7 in
       lookup <'pcr10', plat> as v10 in
         let quoted = <'quote', plat, v0, v7, v10, nonce> in
         event TPMQuote(plat, v0, v7, v10, nonce);
         out(<quoted, sign(quoted, aik)>)
       else 0
       else 0
       else 0
       else 0 )

let HostBoot =
    lookup 'bin_good' as b in
      let mb = h(b) in
      event BinaryLoaded('host', b, mb);
      out(<'extend', 'host', mb>);
      event IMAMeasured('host', mb)
    else 0

let MeasurementCollector =
    !( in(<'measurement', m, t>);
       event CollectorRelayed(m, t);
       out(<'collected', m, t>) )

let DataExporterRelay =
    !( in(<'collected', m, t>);
       event ExporterRelayed(m, t);
       out(<'exported', m, t>) )

let IMALogService =
    !( in(<'ima_log_req', plat>);
       lookup 'bin_good' as b in
         out(<'ima_log', plat, h(b)>)
       else 0 )

let eBPFTag =
    !( lookup 'k_tag' as k in
         new m;
         let t = uhash(k, m) in
         event MeasurementGenerated(m, t);
         out(<'measurement', m, t>)
       else 0 )

let TagKeyCompromise =
    lookup 'k_tag' as k in
      event TagKeyRevealed(k);
      out(k)
    else 0

let EnclaveKeys =
    new msk;
    let ska = kdf(msk, 'anchor_sig') in
    event EnclaveInit(pk(ska));
    event AnchorKey(ska);
    insert 'anchor_sk',        ska;
    insert 'anchor_pk_pinned', pk(ska);
    out(<'anchor_pk', pk(ska)>)

let EnclaveAdmission =

    lookup 'aik_host' as aikpub in
    new nE;
    out(<'quote_req', 'host', nE>);
    in(<<'quote', 'host', v0, v7, v10, nr>, sig>);
    if nr = nE then
    if verify(sig, <'quote', 'host', v0, v7, v10, nr>, aikpub) = true then
      out(<'ima_log_req', 'host'>);
      in(<'ima_log', 'host', logb>);
      if h(<'zero', logb>) = v10 then
        lookup 'ref_state' as st in
          if <v0, v7, v10, logb> = st then
            event BootAdmitted('host', v0, v7, v10, logb);
            insert 'admitted', <v0, v7, v10, logb>
          else 0
        else 0
      else 0
    else 0
    else 0
    else 0

let EnclaveIngest =
    !( in(<'exported', m, t>);
       lookup 'admitted' as adm in
       lookup 'k_tag'    as ktag in
       lookup 'k_chain'  as kchain in
         if t = uhash(ktag, m) then
           event TagAccepted(m, t);
           in(<'topology', g>);
           let eg = <'share', g, m> in
           event Attributed(g, m, eg);
           lookup <'chain', g> as hprev in
           lookup <'ctr', g>   as cprev in
             let ci  = <'s', cprev> in
             let hi  = h(<hprev, eg>) in
             let rec = <g, ci, eg, hi> in
             let mac = hmac(kchain, rec) in
             insert <'chain', g>, hi;
             insert <'ctr', g>,   ci;
             event ChainStep(g, ci, eg, hprev, hi);
             event HostExported(g, ci, eg, hi, mac);
             out(<'guest_record', rec, mac>);
             lookup 'batch' as bt in
               insert 'batch', <bt, rec>
             else 0
           else 0
           else 0
         else 0
       else 0
       else 0
       else 0 )

let EnclaveSeal =
    !( in('seal_block');
       lookup 'admitted'  as adm in
       lookup 'anchor_sk' as ska in
       lookup 'batch'     as bt in
       lookup 'croot'     as cprev in
       lookup 'blockno'   as bn in
         let bnext  = <'s', bn> in
         let rj     = mroot(bt) in
         let cj     = h(<cprev, rj>) in
         let anchor = <'anchor', bnext, rj, cj> in
         insert 'croot',   cj;
         insert 'blockno', bnext;
         insert 'batch',   'empty';
         event BlockSealed(bnext, bt, rj, cprev, cj);

         out(<'stored_block', bt, anchor, sign(anchor, ska)>)
       else 0
       else 0
       else 0
       else 0
       else 0 )

let GuestAttestation(g) =
    in(<'aik_pub', gid, gaik>);
    if gid = g then
    new ng;
    out(<'quote_req', g, ng>);
    in(<<'quote', gq, w0, w7, w10, nq>, gsig>);
    if gq = g then
    if nq = ng then
    if verify(gsig, <'quote', gq, w0, w7, w10, nq>, gaik) = true then
      event GuestAttested(g, w0, w7, w10);
      insert <'gattested', g>, <w0, w7, w10>

let GuestVerification(g) =
    !( in(<'guest_record', <gr, ci, eg, hi>, mac>);
       lookup <'gattested', g> as att in
       lookup 'k_chain' as kchain in
         if gr = g then
         if mac = hmac(kchain, <g, ci, eg, hi>) then
           lookup <'gchain', g> as gprev in
             if hi = h(<gprev, eg>) then
               insert <'gchain', g>, hi;
               event GuestAccepted(g, ci, eg, gprev, hi)
             else
               event GuestRejected(g, ci, eg)
           else 0
       else 0
       else 0 )

let GuestSpawn =
    new g;
    event GuestCreated(g);
    insert <'chain',  g>, 'zero';
    insert <'ctr',    g>, 'zero';
    insert <'gchain', g>, 'zero';
    out(<'guest_id', g>);
    ( TPMProvision(g) | TPMExtend(g) | TPMQuote(g)
    | GuestAttestation(g) | GuestVerification(g) )

let AuditorInit =
    insert 'acroot', 'zero'

let AuditorVerify =
    !( in(<'stored_block', bt, <'anchor', bn, rj, cj>, asig>);
       lookup 'anchor_pk_pinned' as apk in
         if verify(asig, <'anchor', bn, rj, cj>, apk) = true then
           if rj = mroot(bt) then
             lookup 'acroot' as acprev in
               if cj = h(<acprev, rj>) then
                 insert 'acroot', cj;
                 event AuditVerified(bn, bt, rj, cj)
               else
                 event AuditRejected(bn, 'chain_link')
             else 0
           else event AuditRejected(bn, 'merkle_root')
         else event AuditRejected(bn, 'signature')
       else 0 )

#ifdef CONF_AUTH
process:
    Provisioning
  | TPMProvision('host') | TPMExtend('host') | TPMQuote('host')
  | HostBoot
  | IMALogService
  | ReferenceRegister
  | EnclaveKeys
  | EnclaveAdmission
#endif

#ifdef CONF_MEAS
process:
    Provisioning
  | TPMProvision('host') | TPMExtend('host') | TPMQuote('host')
  | HostBoot
  | IMALogService
  | ReferenceRegister
  | EnclaveKeys
  | EnclaveAdmission
  | !eBPFTag
  | MeasurementCollector
  | DataExporterRelay
  | EnclaveIngest
  | TagKeyCompromise
#endif

#ifdef CONF_CHAIN
process:
    Provisioning
  | TPMProvision('host') | TPMExtend('host') | TPMQuote('host')
  | HostBoot
  | IMALogService
  | ReferenceRegister
  | EnclaveKeys
  | EnclaveAdmission
  | eBPFTag
  | MeasurementCollector
  | DataExporterRelay
  | EnclaveIngest
  | !GuestSpawn
#endif

#ifdef CONF_STORE
process:
    Provisioning
  | AuditorInit
  | TPMProvision('host') | TPMExtend('host') | TPMQuote('host')
  | HostBoot
  | IMALogService
  | ReferenceRegister
  | EnclaveKeys
  | EnclaveAdmission
  | eBPFTag
  | MeasurementCollector
  | DataExporterRelay
  | EnclaveIngest
  | EnclaveSeal
  | GuestSpawn
  | AuditorVerify
#endif

#ifdef FULL
process:
    Provisioning
  | AuditorInit
  | TPMProvision('host') | TPMExtend('host') | TPMQuote('host')
  | HostBoot
  | IMALogService
  | ReferenceRegister
  | EnclaveKeys
  | EnclaveAdmission
  | MeasurementCollector
  | DataExporterRelay
  | EnclaveIngest
  | EnclaveSeal
  | AuditorVerify
  | !eBPFTag
  | !GuestSpawn
  | TagKeyCompromise
#endif

lemma exec_full_pipeline:
  exists-trace
  "Ex g m t eg ci gprev hi mac #a #b #c #d.
       TagAccepted(m, t) @ #a
     & Attributed(g, m, eg) @ #b
     & HostExported(g, ci, eg, hi, mac) @ #c
     & GuestAccepted(g, ci, eg, gprev, hi) @ #d
     & #a < #b & #b < #c & #c < #d"

lemma exec_block_audited:
  exists-trace
  "Ex bn bt rj cprev cj #i #j.
       BlockSealed(bn, bt, rj, cprev, cj) @ #i
     & AuditVerified(bn, bt, rj, cj) @ #j
     & #i < #j"

lemma platform_authenticity [use_induction]:
  "All plat v0 v7 v10 hb #i.
     BootAdmitted(plat, v0, v7, v10, hb) @ #i
     ==> (Ex n #j. TPMQuote(plat, v0, v7, v10, n) @ #j & #j < #i)
       & (Ex #k. ReferenceStateFixed(plat, v0, v7, v10, hb) @ #k & #k < #i)"

lemma tee_authenticity:
  "All bn bt rj cj #i.
     AuditVerified(bn, bt, rj, cj) @ #i
     ==> Ex cprev #j. BlockSealed(bn, bt, rj, cprev, cj) @ #j & #j < #i"

lemma measurement_integrity:
  "All m t #i.
     TagAccepted(m, t) @ #i
     ==> (Ex #j. MeasurementGenerated(m, t) @ #j & #j < #i)
       | (Ex k #r. TagKeyRevealed(k) @ #r & #r < #i)"

lemma measurement_forgery_when_tag_key_public:
  exists-trace
  "Ex m t #i.
       TagAccepted(m, t) @ #i
     & not(Ex #j. MeasurementGenerated(m, t) @ #j)"

lemma host_to_guest_authentication:
  "All g ci eg gprev hi #i.
     GuestAccepted(g, ci, eg, gprev, hi) @ #i
     ==> Ex mac #j. HostExported(g, ci, eg, hi, mac) @ #j & #j < #i"

lemma guest_authenticity:
  "All g ci eg gprev hi #i.
     GuestAccepted(g, ci, eg, gprev, hi) @ #i
     ==> Ex w0 w7 w10 #j. GuestAttested(g, w0, w7, w10) @ #j & #j < #i"

lemma replay_protection [use_induction]:
  "All g ci eg1 eg2 p1 p2 h1 h2 #i #j.
       GuestAccepted(g, ci, eg1, p1, h1) @ #i
     & GuestAccepted(g, ci, eg2, p2, h2) @ #j
     ==> #i = #j"

lemma chain_integrity [use_induction]:
  "All g ci eg gprev hi #i.
     GuestAccepted(g, ci, eg, gprev, hi) @ #i
     ==> (gprev = 'zero')
       | (Ex ci2 eg2 p2 #j.
            GuestAccepted(g, ci2, eg2, p2, gprev) @ #j & #j < #i)"

lemma merkle_root_binding:
  "All bn1 bn2 bt1 bt2 rj cj1 cj2 #i #j.
       AuditVerified(bn1, bt1, rj, cj1) @ #i
     & AuditVerified(bn2, bt2, rj, cj2) @ #j
     ==> bt1 = bt2"

lemma append_only_storage [use_induction]:
  "All bn bt rj cprev cj #i.
     BlockSealed(bn, bt, rj, cprev, cj) @ #i
     ==> (cprev = 'zero')
       | (Ex bn2 bt2 rj2 cp2 #j.
            BlockSealed(bn2, bt2, rj2, cp2, cprev) @ #j & #j < #i)"

lemma historical_auditability [use_induction]:
  "All bn bt rj cj #i.
     AuditVerified(bn, bt, rj, cj) @ #i
     ==> (rj = mroot(bt))
       & (Ex cprev #j. BlockSealed(bn, bt, rj, cprev, cj) @ #j & #j < #i)"

lemma offline_verification_correctness:
  "All bn bt1 bt2 rj1 rj2 cj1 cj2 #i #j.
       AuditVerified(bn, bt1, rj1, cj1) @ #i
     & AuditVerified(bn, bt2, rj2, cj2) @ #j
     ==> bt1 = bt2"

lemma key_secrecy_chain:
  "All k #i. SecretKey('chain', k) @ #i ==> not(Ex #j. K(k) @ #j)"

lemma key_secrecy_anchor:
  "All ska #i. AnchorKey(ska) @ #i ==> not(Ex #j. K(ska) @ #j)"

lemma key_secrecy_tag:
  "All k #i.
     SecretKey('tag', k) @ #i
     ==> (Ex #r. TagKeyRevealed(k) @ #r) | not(Ex #j. K(k) @ #j)"

end
